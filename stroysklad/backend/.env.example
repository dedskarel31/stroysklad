# --- Локальная разработка ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stroysklad
DB_USER=postgres
DB_PASSWORD=postgres

# --- На Railway используется DATABASE_URL (вместо отдельных параметров) ---
# DATABASE_URL=postgresql://user:password@host:port/database

# JWT
JWT_SECRET=ChangeMeToSomethingLongAndRandom_at_least_32_chars

# Сервер
PORT=3001

# CORS: список разрешённых доменов через запятую (можно оставить пустым для разрешения всех)
# Пример для прода: CORS_ORIGINS=https://stroysklad.vercel.app,http://localhost:5173
CORS_ORIGINS=
